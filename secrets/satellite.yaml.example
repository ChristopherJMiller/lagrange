# Plaintext template. Encrypt with:
#   sops --encrypt --age <operator_pubkey>,<lagrange_pubkey> secrets/satellite.yaml.example > secrets/satellite.yaml
#
# Don't commit the plaintext. The encrypted .yaml goes in git; this template
# stays alongside as documentation only.

comin-token: |
  ghp_REPLACE_ME

wg-private-key: |
  REPLACE_WITH_WIREGUARD_PRIVATE_KEY=

admin-service-token: |
  REPLACE_WITH_LONG_RANDOM_HEX

atticd-env: |
  ATTIC_SERVER_TOKEN_RS256_SECRET_BASE64=REPLACE_WITH_RS256_KEY_BASE64

# A tar.gz of per-repo deploy keys, base64-encoded. The admin service unpacks
# this into /var/lib/lagrange-admin/deploy-keys/<repo-name> on first boot.
# Optional — only needed if any repo-VMs use SSH-based git auth.
deploy-keys-tar: |
  H4sIAAAAAAAA__REPLACE_WITH_BASE64_TAR__
